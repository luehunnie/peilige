# Peilige V1 — production Caddyfile (pure static site).
# Domain-neutral: listens on :8080 (unprivileged — the container runs as a
# non-root user, see deploy/Dockerfile); hostname/TLS is decided at deploy
# time by surrounding infrastructure, never hardcoded here.

:8080

root * /srv

# zstd preferred, gzip fallback
encode zstd gzip

# Security + cache headers (applied to every response; separate fields,
# so no interaction with the Cache-Control routes below).
header {
	# Server identity hidden.
	-Server
	# No MIME sniffing.
	X-Content-Type-Options nosniff
	# Clickjacking: legacy + modern equivalent, both on purpose.
	X-Frame-Options DENY
	Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; media-src 'none'; worker-src 'none'"
	# Minimal referrer leakage on cross-origin navigations.
	Referrer-Policy strict-origin-when-cross-origin
	# The site uses none of these browser capabilities — deny them all.
	Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
	# NOTE: Strict-Transport-Security is deliberately NOT set here. HSTS must
	# be enabled by the real HTTPS/TLS entrypoint after domain ownership is
	# confirmed — see SECURITY.md (Infrastructure Responsibilities).
	#
	# CSP notes (policy is derived from the actual page, keep it that way):
	#   - no inline <script>/<style> exists in index.html → no unsafe-inline
	#   - img-src data: is required only for the inline SVG data-URI favicon
	#   - CSS uses system fonts only → no font-src needed
}

# Cache policy. The three matchers below are deliberately MUTUALLY
# EXCLUSIVE so the resulting header never depends on directive ordering.
#
# Static assets: medium cache. Filenames are NOT content-hashed, so a long
# immutable lifetime would serve stale CSS/JS after an update. 24h with
# must-revalidate balances reuse against freshness.
@static path /css/* /js/* /assets/*
header @static Cache-Control "public, max-age=86400, must-revalidate"

# Liveness: answered by Caddy itself, never cached.
@healthz path /healthz
header @healthz Cache-Control "no-store"

# Everything else — index.html above all — always revalidate so deploys
# are picked up immediately.
@revalidate not path /css/* /js/* /assets/* /healthz
header @revalidate Cache-Control "no-cache"

respond /healthz "ok" 200

file_server
